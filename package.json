{
  "name": "wix",
  "version": "1.0.0",
  "description": "Category Tree",
  "default": "index.html",
  "scripts": {
    "lint:js": "npx eslint --cache \"src/**/*.js\"",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint": "npm run lint:js:fix && npm run prettify",
    "lint:staged": "npx lint-staged",
    "prebuild": "shx rm -rf dist/*",
    "prettify": "npx prettier --write \"**/*.{js,scss,md,html}\"",
    "start": "parcel ./index.html",
    "build": "parcel build index.html --dist-dir ./public",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitaminvp/category-tree.git"
  },
  "author": "Vitalii Ovcharenko",
  "license": "ISC",
  "homepage": "https://github.com/Vitaminvp/category-tree#readme",
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-transform-modules-commonjs": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@parcel/transformer-image": "^2.0.0-rc.0",
    "@parcel/transformer-sass": "^2.0.0-rc.0",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^3.4.1",
    "jest": "^27.1.0",
    "lint-staged": "^11.1.2",
    "parcel": "^2.0.0-rc.0",
    "sass": "^1.38.1",
    "shx": "^0.3.3",
    "prettier": "^2.3.2"
  },
  "browserslist": [
    "since 2021-01"
  ],
  "pre-commit": "lint:staged",
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --cache --fix"
    ],
    "**/*.{js,css,md,html}": [
      "prettier --write"
    ]
  }
}
