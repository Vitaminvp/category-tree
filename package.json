{
  "name": "wix",
  "version": "1.0.0",
  "description": "Category Tree",
  "default": "index.html",
  "scripts": {
    "lint:ts": "npx eslint --cache \"src/**/*.ts\"",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "lint": "npm run lint:js:fix && npm run prettify",
    "lint:staged": "npx lint-staged",
    "prebuild": "shx rm -rf dist/*",
    "prettify": "npx prettier --write \"**/*.{ts,scss,md,html}\"",
    "start": "parcel ./index.html --open",
    "build": "parcel build index.html --no-minify --public-url ./ --out-dir ./public",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitaminvp/category-tree.git"
  },
  "author": "Vitalii Ovcharenko",
  "license": "ISC",
  "homepage": "https://github.com/Vitaminvp/category-tree#readme",
  "devDependencies": {
    "@babel/core": "^7.7.5",
    "@babel/preset-env": "^7.7.6",
    "@types/jest": "^25.1.4",
    "@types/svg-injector": "0.0.27",
    "@typescript-eslint/eslint-plugin": "^2.25.0",
    "@typescript-eslint/parser": "^2.11.0",
    "autoprefixer": "^9.7.3",
    "cssnano": "^5.0.8",
    "eslint": "^6.7.2",
    "eslint-plugin-prettier": "^3.4.1",
    "jest": "^25.2.4",
    "lint-staged": "^11.1.2",
    "parcel-bundler": "^1.12.4",
    "parcel-plugin-structurize": "^1.1.6",
    "postcss": "^8.3.6",
    "postcss-url": "^8.0.0",
    "prettier": "^2.3.2",
    "sass": "^1.23.7",
    "shx": "^0.3.3",
    "svg-injector": "^1.1.3",
    "ts-jest": "^25.3.0",
    "typescript": "^3.7.3"
  },
  "browserslist": [
    "since 2021-01"
  ],
  "pre-commit": "lint:staged",
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --cache --fix"
    ],
    "**/*.{js,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/preset-flow": "^7.14.5",
    "core-js": "^3.17.1"
  }
}
